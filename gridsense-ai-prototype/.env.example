# =============================================================================
# GridSense AI - Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# =============================================================================

# Backend Gateway Port
PORT=4000
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL Persistence (Optional - if omitted, runs in zero-dependency In-Memory mode)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gridsense_db

# Microservices URLs
ML_SERVICE_URL=http://127.0.0.1:8000
RAG_SERVICE_URL=http://127.0.0.1:8001

# AI / LLM Keys (Optional - if omitted, local grounded document retriever is used)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
